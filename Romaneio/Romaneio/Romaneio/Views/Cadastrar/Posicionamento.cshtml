@model Romaneio.Models.ViewModels.PosicionamentoViewModel

@{
    ViewBag.Title = "Posicionamento";
}

<h2 style="color: #8a730b !important;">Posicionamento</h2>

<a href="@Url.Action("Cadastrar", "Cadastrar", new { AUTONUM_ROMANEIO = Model.AUTONUM_ROMANEIO})" class="btn btn-secondary btn-sm" style="float:right"> &nbsp;Voltar</a>
<br /><br />

@if (TempData["MensagemErro"] != null)
{
    <br />
    <div class="alert alert-danger" role="alert" id="alert-error">
        <button type="button" class="btn btn-danger btn-sm close-alert" data-bs-dismiss="alert" arial-label="close" onclick="closeAlert('alert-error')">X</button>
        @TempData["MensagemErro"]
    </div>
}


@if (TempData["MensagemSucesso"] != null)
{
    <br />
    <div class="alert alert-success" role="alert" id="alert-success">
        <button type="button" class="btn btn-success btn-sm close-alert" aria-label="close" onclick="closeAlert('alert-success')">X</button>
        @TempData["MensagemSucesso"]
    </div>
}

<br />
@using (Html.BeginForm("SalvarYard", "Cadastrar", FormMethod.Get))
{
<div class="row">
    <div class="col-md-2">
        <label>Romaneio:</label>
        @Html.EditorFor(model => model.AUTONUM_ROMANEIO, new { htmlAttributes = new { @class = "form-control", @readonly = "@readonly" } })
    </div>
    <div class="col-md-2">
        <label>Pátio:</label>
        @Html.EditorFor(model => model.PATIO, new { htmlAttributes = new { @class = "form-control", @readonly = "@readonly" } })
    </div>
    <div class="col-md-2">
        <label>Lote:</label>
        @Html.EditorFor(model => model.LOTE, new { htmlAttributes = new { @class = "form-control", @readonly = "@readonly" } })
    </div>
    <div class="col-md-2">
        <label>Conteiner:</label>
        @Html.EditorFor(model => model.ID_CONTEINER, new { htmlAttributes = new { @class = "form-control", @readonly = "@readonly" } })
    </div>
    <div class="col-md-2">
        <label>Item:</label>
        @Html.EditorFor(model => model.ITEM, new { htmlAttributes = new { @class = "form-control", @readonly = "@readonly" } })
    </div>
    <div class="col-md-2" style="display:none">
        @Html.EditorFor(model => model.AUTONUM_CNTR, new { htmlAttributes = new { @class = "form-control data", @readonly = "@readonly" } })
        @Html.EditorFor(model => model.AUTONUM_CS, new { htmlAttributes = new { @class = "form-control data", @readonly = "@readonly" } })

    </div>
</div>
    <div class="row">
        <div class="col-md-2">
            <label>Quantidade:</label>
            @Html.TextBox("QUANTIDADE", null, new { @class = "form-control", id = "txtQtd" })
        </div>
        <div class="col-md-4">
            <label>Posição:</label>
            @Html.TextBox("POSICAO", null, new { @class = "form-control", id = "txtPosicao" })
        </div>
        <div class="col-md-4">
            <label>Armazém:</label>
            @Html.DropDownListFor(model => model.ARMAZEM, new MultiSelectList(Model.LISTA_ARMAZENS, "AUTONUM", "DESCRICAO"), string.Empty, new { @class = "form-control total", id = "ddlArmazem" })
        </div>
        <div class="col-md-2">
            <label style="color:white">.</label>
            <button type="submit" class="btn btn-block btn-success">Salvar</button>
        </div>

    </div>

}
<br />
<br />
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ITEM</th>
            <th>QUANTIDADE</th>
            <th>POSIÇÃO</th>
            <th>ARMAZÉM</th>
            <th> </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.LISTA_POSICIONAMENTOS)
        {
            <tr>
                <td>@item.ITEM</td>
                <td>@item.QUANTIDADE</td>
                <td>@item.POSICAO</td>
                <td>@item.ARMAZEM</td>
                <td><button type="button" class="btn btn-danger" data-autonum-cs="@item.AUTONUM_CS" data-autonum="@item.AUTONUM_YARD" onclick="Excluir(this)">Excluir</button></td>
            </tr>
        }
    </tbody>
</table>

<script language="JavaScript" type="text/javascript" src="~/Content/js/jquery-3.3.1.js"></script>
<script language="JavaScript" type="text/javascript" src="~/Content/js/bootstrap.min.js"></script>


<script>

    function closeAlert(alertId) {
        var alert = document.getElementById(alertId);
        alert.style.display = 'none';
    }


    function Salvar(button) {
        var inicio = $(button).data('inicio');
        var fim = $(button).data('fim');
        var romaneio = $(button).data('romaneio');
        console.log("inicio " + inicio);
        console.log("fim " + fim);
        console.log("romaneio " + romaneio);


        if (inicio == "") {
            alert("Lote não iniciado!");
        }
        else if (romaneio == "") {
            alert("Lote não iniciado!");
        }
        else if (fim != "") {
            alert("Lote já finalizado!");

        }
        else {

            alert("entrou no else");

            @*$.ajax({
            url: '@Url.Action("SalvarYard", "Cadastrar")', // Chama a action no controller
            type: 'GET',
                data: { patio: patio, cntr: cntr, lote: lote, item: item},
            success: function (data) {
            $('#modal-body').html(data);
            $('#Modal').modal('show');
            },
            error: function () {
            alert("Erro ao carregar dados.");
            }
            });*@
         }

    }


    function Excluir(button) {

        var row = $(button).closest("tr");

        // Pega o ID do item para ser excluído
        var AUTONUM = $(button).data("autonum");
        var AUTONUM_CS = $(button).data("autonum-cs");

        console.log("linha: " + row);
        console.log("AUTONUM: " + AUTONUM);
        console.log("AUTONUM_CS: " + AUTONUM_CS);

        // Faz a requisição AJAX para o controller
        $.ajax({
            url: '@Url.Action("ExcluirYard", "Cadastrar")', // Chama a ação ExcluirItem no controller Item
            type: 'POST',
            data: { AUTONUM: AUTONUM, AUTONUM_CS: AUTONUM_CS }, // Envia o ID do item para o controller
            success: function(response) {
                if (response.success) {
                    // Se a exclusão for bem-sucedida, remove a linha da tabela
                    row.remove();
                } else {
                    alert(response.message || "Erro ao excluir o item.");
                }
            },
            error: function() {
                alert("Erro ao comunicar com o servidor.");
            }
        });
    }

</script>

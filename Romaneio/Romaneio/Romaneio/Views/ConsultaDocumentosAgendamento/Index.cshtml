@model Romaneio.Models.ViewModels.ConsultaDocumentosAgendamentoPageViewModel

@{
    ViewBag.Title = Model.TITULO ?? "Documentos do agendamento";
}

<h3 class="page-title">
    <i class="glyphicon glyphicon-file"></i>
    @(Model.TITULO ?? "Documentos do agendamento")
</h3>

<div id="alert-container"></div>

@if (!string.IsNullOrEmpty(Model.Erro))
{
    <div class="alert alert-danger">@Model.Erro</div>
}
else
{
    <div class="card-custom">
        <div class="row">
            <div class="col-md-5">
                <label>Documentos</label>
                <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                    <table class="table table-bordered table-condensed table-hover" id="tblDocs">
                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Arquivo</th>
                                <th>Inclusao</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-7">
                <label>Visualizacao</label>
                <div id="pnlPreview" class="well" style="min-height: 420px; padding: 0;">
                    <iframe id="ifrDoc" title="Documento" style="width: 100%; height: 420px; border: none; display: none;"></iframe>
                    <img id="imgDoc" alt="Documento" style="max-width: 100%; display: none;" />
                    <p id="lblPreview" class="text-muted" style="padding: 15px;">Selecione um documento na lista.</p>
                </div>
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-2">
                <button type="button" id="btnFechar" class="btn btn-default btn-block">Fechar e liberar bloqueio</button>
            </div>
            <div class="col-md-2 col-md-offset-8">
                <button type="button" id="btnVoltar" class="btn btn-primary btn-block">Voltar ao sistema</button>
            </div>
        </div>
    </div>
}

<script>
    window.consultaDocumentosAgendaConfig = {
        ltl: @(Model.LTL ? "true" : "false"),
        lote: @(Model.LOTE),
        ag: @(Model.AUTONUM_AGENDAMENTO),
        urls: {
            listar: '@Url.Action("Listar", "ConsultaDocumentosAgendamento")',
            arquivo: '@Url.Action("Arquivo", "ConsultaDocumentosAgendamento")',
            fechar: '@Url.Action("Fechar", "ConsultaDocumentosAgendamento")',
            home: '@Url.Action("Home", "Home")'
        }
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script type="text/javascript" src="~/Content/js/consulta-documentos-agendamento.js"></script>

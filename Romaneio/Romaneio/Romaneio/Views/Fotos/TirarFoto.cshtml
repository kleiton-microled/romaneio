</div>
@using (Html.BeginForm("SalvarFoto", "Fotos", FormMethod.Post))
{
    <div id="divAuxiliares" style="display:none"> 

    @Html.EditorFor(model => model.AUTONUM_ROMANEIO, new { htmlAttributes = new { @class = "form-control  ", @readonly = "@readonly" } })

    @Html.TextBox("FOTO", null, new { @class = "form-control", id = "txtImagemBase64" })
   
    </div>
    <div class="modal-body"> 
        <form id="fotosForm">
            <div class="row">
                <div class="col-md-8">
                    <div id="imgCamera"></div>
                </div>
                <br />

                <div class="col-md-4">
                    @*<div class="col-sm-offset-3 col-md-8">
            <a href="#" onclick="TirarFoto();" id="btnTirarFoto" class="btn btn-success">Bater Foto </a>
            <a href="#" onclick="Resetar();" id="btnResetarFoto" class="btn btn-danger" style="float:right">Resetar</a>
        </div>*@
                    <br />
                    <br />
                    <label class="form-label">Tipo Foto</label>
                    @Html.DropDownListFor(model => model.ID_TIPO_FOTO, new MultiSelectList(Model.LISTA_TIPO_FOTO, "AUTONUM", "DESCRICAO"), string.Empty, new { @class = "form-control total" })

                    <br />

                    <label class="form-label">Descrição</label>
                    @Html.TextBox("DESCRICAO", null, new { @class = "form-control" })

                    <br />

                    <label class="form-label">Observação</label>
                    @Html.TextArea("OBSERVACAO", null, new { @class = "form-control" })

                    <br />
                    <div class="col-md-12">
                        <a href="#" onclick="TirarFoto();" id="btnTirarFoto" class="btn btn-success">📸 Bater Foto </a>
                        <a href="#" onclick="Resetar();" id="btnResetarFoto" class="btn btn-warning">❌ Resetar</a>
                        <button type="submit" class="btn  btn-primary">💾 Salvar Foto</button>
                    </div>
                </div>

                </div>
            @*<div class="row">
                <div class="col-md-2">
                    <a href="#" onclick="TirarFoto();" id="btnTirarFoto" style="margin-right: 100px" class="btn btn-success btn-block">Bater Foto </a>
                </div>
                <div class="col-md-2">
                        <a href="#" onclick="Resetar();" id="btnResetarFoto" class="btn btn-danger btn-block">Resetar</a>
                 </div>

           </div>*@


</form>
    </div>
}



<script type="text/javascript" src="~/Content/js/jquery.min.js"></script>
<script type="text/javascript" src="~/Content/js/moment-with-locales.js"></script>
<script type="text/javascript" src="~/Content/js/webcam.min.js"></script>




<script type="text/javascript">

    var previousOrientation = window.orientation;
    var checkOrientation;

    $(document).ready(function () {
        try {

            AbrirCamera();


        } catch (e) {
            console.log(e);
        }

    });


    function TirarFoto() {
        Webcam.snap(function (foto) {
            var imagemBase64 = foto.toString().replace('data:image/jpeg;base64,', '');
            $('#txtImagemBase64').val(imagemBase64);
            $('#imgCamera')
                .removeClass('invisivel')
                .html('<img src="' + foto + '" />');
        });
    }




    function Resetar() {
        $('#txtImagemBase64').val('');
        AbrirCamera();
    }



    function AbrirCamera() {



        if (window.screen.height < window.screen.width) {
            Webcam.set({
                width: 700,
                height: 680,
                image_format: 'jpeg',
                enable_flash: true,
            });
            Webcam.set('constraints', {
                facingMode: 'environment',
                width: 700,
                height: 680,
                image_format: 'jpeg',
                enable_flash: true,
            });

            Webcam.attach('#imgCamera');
            $('#imgCamera')
                .css('width', '700px')
                .css('height', '680px');
        }

        else {
            Webcam.set({
                width: 680,
                height: 700,
                image_format: 'jpeg',
                enable_flash: true,
            });
            Webcam.set('constraints', {
                facingMode: 'environment',
                width: 680,
                height: 700,
                image_format: 'jpeg',
                enable_flash: true,
            });
            Webcam.attach('#imgCamera');
            $('#imgCamera')
                .css('width', '680px')
                .css('height', '700px');
        }


    }


    var previousOrientation = window.orientation;
    var checkOrientation = function () {
        if (window.orientation !== previousOrientation) {
            previousOrientation = window.orientation;
            // orientation changed, do your magic here
            AbrirCamera()
        }
    };


    window.addEventListener("resize", checkOrientation, false);
    window.addEventListener("orientationchange", checkOrientation, false);

    // (optional) Android doesn't always fire orientationChange on 180 degree turns
    setInterval(checkOrientation, 2000);



</script>



@model Romaneio.Models.ViewModels.ManutencaoMarcantesArmazemViewModel

@{
    ViewBag.Title = "Manutencao Marcantes Armazem";
}

<h2 class="page-title">
    <i class="glyphicon glyphicon-wrench"></i> Manutencao - Marcantes Armazem
</h2>

<div id="alert-container"></div>

<div class="card-custom" id="painel-manutencao-marcantes-armazem">
    <div class="row">
        <div class="col-md-2">
            <label>Lote</label>
            <input type="text" id="txtLote" class="form-control" maxlength="7" inputmode="numeric" autocomplete="off" />
        </div>
        <div class="col-md-2">
            <label style="color:white">.</label>
            <button id="btnFiltrar" type="button" class="btn btn-primary btn-block">[F4] Filtra</button>
        </div>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-3">
            <label>Embalagem</label>
            <input type="text" id="txtEmbalagem" class="form-control" readonly />
        </div>
        <div class="col-md-2">
            <label>Qtde (referencia)</label>
            <input type="text" id="txtQtdeRef" class="form-control" readonly />
        </div>
        <div class="col-md-2">
            <label>TTL (lista)</label>
            <input type="text" id="txtTotalLista" class="form-control" readonly />
        </div>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-12">
            <label>Marcantes</label>
            <table class="table table-bordered table-hover" id="tblMarcantes">
                <thead>
                    <tr>
                        <th style="width:50px;">#</th>
                        <th>Armazem</th>
                        <th>Posicao</th>
                        <th>Item</th>
                        <th>Qtd</th>
                        <th>Marcante</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-3">
            <label>Marcante</label>
            <input type="text" id="txtMarcanteSel" class="form-control" readonly maxlength="9" />
        </div>
        <div class="col-md-2">
            <label>Qtde (nova)</label>
            <input type="number" id="txtNovaQtde" class="form-control" min="0" step="1" />
        </div>
        <div class="col-md-2">
            <label style="color:white">.</label>
            <button id="btnSalvar" type="button" class="btn btn-success btn-block">[F5] Salva</button>
        </div>
        <div class="col-md-2">
            <label style="color:white">.</label>
            <button id="btnSair" type="button" class="btn btn-default btn-block">[ESC] Voltar</button>
        </div>
    </div>
</div>

<script>
    window.manutencaoMarcantesArmazemConfig = {
        urls: {
            filtrar: '@Url.Action("Filtrar", "ManutencaoMarcantesArmazem")',
            salvar: '@Url.Action("Salvar", "ManutencaoMarcantesArmazem")',
            sair: '@Url.Action("Index", "Home")'
        }
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Content/js/manutencao-marcantes-armazem.js"></script>
